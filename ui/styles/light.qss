QMainWindow {
  background: #F4F1EA;
}

QWidget#AppShell,
QWidget#DashboardScreen,
QWidget#FormScreen,
QStackedWidget#ContentStack {
  background: #F4F1EA;
}

QDialog,
QMenu,
QCalendarWidget,
QAbstractScrollArea,
QWidget#qt_scrollarea_viewport {
  background: #F4F1EA;
  color: #111827;
}

QAbstractItemView {
  alternate-background-color: #FAF9F5;
  background: #FFFFFF;
  border: 1px solid #D6D2C8;
  color: #111827;
  selection-background-color: #D94625;
  selection-color: #FFFFFF;
}

QAbstractItemView::item:hover {
  background: #EAE6DF;
}

QAbstractItemView::item:selected {
  background: #FCE8E5;
  color: #111827;
}

QAbstractItemView#DataTable {
  outline: 0;
}

QScrollBar:horizontal,
QScrollBar:vertical {
  background: #EAE6DF;
  border: 1px solid #D6D2C8;
}

QScrollBar::handle:horizontal,
QScrollBar::handle:vertical {
  background: #D94625;
  border: 1px solid #F5978A;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:hover {
  background: #E0533C;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  background: #EAE6DF;
  border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: #FFFFFF;
}

QSplitter::handle {
  background: #D6D2C8;
  border-color: #A19B90;
}

QMenu::item:selected {
  background: #D94625;
  color: #FFFFFF;
}

QMenu::item:disabled {
  color: #78716C;
}

QLabel {
  color: #111827;
}

QFrame#InfoCard {
  background: #EAE6DF;
  border: 1px solid #D6D2C8;
}

QFrame#InfoCard:hover {
  border-color: #A19B90;
}

QLabel#InfoCardLabel {
  color: #57534E;
}

QLabel#InfoCardValue {
  color: #0369A1;
}

QLabel#InfoCardValue[accentRole="accent"] {
  color: #d94625;
}

QLabel#InfoCardValue[accentRole="success"] {
  color: #059669;
}

QLabel#InfoCardValue[accentRole="warning"] {
  color: #d97706;
}

QLabel#InfoCardValue[accentRole="danger"] {
  color: #e11d48;
}

QLabel#InfoCardValue[accentRole="info"] {
  color: #0284c7;
}

QLabel#InfoCardDetail {
  color: #736B60;
}

QTextEdit#BacktestResultText {
  background: #ffffff;
  color: #1e293b;
}

QLabel#BacktestVerdict[verdictState="empty"] {
  background: #f1f5f9;
  border: 1px solid #cbd5e1;
}

QLabel#BacktestVerdict[verdictState="success"] {
  background: #d1fae5;
  border: 1px solid #a7f3d0;
}

QLabel#BacktestVerdict[verdictState="warning"] {
  background: #fef3c7;
  border: 1px solid #fde68a;
}

QLabel#BacktestVerdict[verdictState="unclear"] {
  background: #ffedd5;
  border: 1px solid #fed7aa;
}

QLabel#BacktestVerdict[verdictState="danger"] {
  background: #ffe4e6;
  border: 1px solid #fecdd3;
}

QLabel#MiniStatValueCompact[metricTone="info"] {
  color: #38bdf8;
}

QLabel#MiniStatValueCompact[metricTone="success"] {
  color: #10b981;
}

QLabel#MiniStatValueCompact[metricTone="warning"] {
  color: #f59e0b;
}

QLabel#MiniStatValueCompact[metricTone="danger"] {
  color: #ef4444;
}

QLabel#MiniStatValueCompact[metricTone="accent"] {
  color: #a855f7;
}

QLabel#MarketBadge {
  color: #374151;
}

QLabel#MarketBadge[metricTone="positive"] {
  color: #059669;
}

QLabel#MarketBadge[metricTone="danger"] {
  color: #BE123C;
}

QLabel#MarketBadge[metricTone="warning"] {
  color: #B45309;
}

QLabel#MarketBadge[metricTone="neutral"] {
  color: #374151;
}

QPushButton#NewsLinkButton[linkTone="past"],
QPushButton#NewsIconButton[linkTone="past"] {
  color: #78716C;
}

QPushButton#NewsLinkButton[linkTone="past"]:hover,
QPushButton#NewsIconButton[linkTone="past"]:hover {
  color: #94a3b8;
}

QPushButton#NewsLinkButton[linkTone="nearest"],
QPushButton#NewsIconButton[linkTone="nearest"] {
  color: #137333;
}

QPushButton#NewsLinkButton[linkTone="nearest"]:hover,
QPushButton#NewsIconButton[linkTone="nearest"]:hover {
  color: #065f46;
}

QPushButton#NewsLinkButton[linkTone="future"],
QPushButton#NewsIconButton[linkTone="future"] {
  color: #C2410C;
}

QPushButton#NewsLinkButton[linkTone="future"]:hover,
QPushButton#NewsIconButton[linkTone="future"]:hover {
  color: #9A3412;
}

QPushButton#NewsLinkButton[linkTone="danger"] {
  color: #b91c1c;
}

QPushButton#NewsLinkButton[linkTone="danger"]:hover {
  color: #7f1d1d;
}

QPushButton#NewsLinkButton[linkTone="warning"] {
  color: #b45309;
}

QPushButton#NewsLinkButton[linkTone="warning"]:hover {
  color: #78350f;
}

QPushButton#DialogAiButton {
  background: #D94625;
  color: #ffffff;
}

QPushButton#DialogAiButton:hover {
  background: #E0533C;
}

QPushButton#DialogAiButton:disabled {
  background: #DEDAD0;
  border: 1px solid #D6D2C8;
  color: #736B60;
}

QLabel#CardDetailLabel {
  color: #888888;
}

QDialog#MarketHelpDialog {
  background: #F4F1EA;
}

QDialog#MarketBriefDialog {
  background: #F4F1EA;
}

QLabel#MarketBriefTitle,
QLabel#MarketBriefSectionTitle {
  color: #D94625;
}

QLabel#MarketBriefTimestamp {
  color: #736B60;
}

QFrame#MarketBriefContainer {
  background: #EDEBE4;
  border: 1px solid #D6D2C8;
}

QFrame#MarketBriefSectionCard {
  background: #ffffff;
  border: 1px solid #D6D2C8;
}

QLabel#MarketBriefSectionContent {
  color: #111827;
}

QLabel#KPICardTitle {
  color: #736B60;
}

QLabel#KPICardValue {
  color: #111827;
}

QLabel#KPICardSub {
  color: #78716c;
}

QFrame#PerformanceKPICard {
  background: #ffffff;
  border: 1px solid #e2e8f0;
}

QFrame#PerformanceKPICard[kpiState="positive"] {
  border-left: 4px solid #10b981;
}

QFrame#PerformanceKPICard[kpiState="negative"] {
  border-left: 4px solid #ef4444;
}

QFrame#PerformanceKPICard[kpiState="warning"] {
  border-left: 4px solid #d97706;
}

QFrame#PerformanceKPICard[kpiState="neutral"] {
  border-left: 4px solid #0284c7;
}

QFrame#PerformanceKPICard[kpiState="muted"] {
  border-left: 4px solid #cbd5e1;
}

QLabel#KPICardValue[kpiState="positive"] {
  color: #059669;
}

QLabel#KPICardValue[kpiState="negative"] {
  color: #dc2626;
}

QLabel#KPICardValue[kpiState="warning"] {
  color: #d97706;
}

QLabel#KPICardValue[kpiState="neutral"] {
  color: #0284c7;
}

QLabel#KPICardValue[kpiState="muted"] {
  color: #94a3b8;
}

QLabel#KPICardSub[kpiState="positive"] {
  color: #047857;
}

QLabel#KPICardSub[kpiState="negative"] {
  color: #b91c1c;
}

QLabel#KPICardSub[kpiState="warning"] {
  color: #b45309;
}

QLabel#KPICardSub[kpiState="neutral"],
QLabel#KPICardSub[kpiState="muted"] {
  color: #475569;
}

QLabel#MissingRText {
  color: #B45309;
}

QFrame#MissingRBanner[state="warning"] {
  background: #fef3c7;
  border: 1px solid #d97706;
}

QLabel#MissingRText[state="warning"] {
  color: #78350f;
}

QLabel#JournalSectionLabel {
  color: #0284C7;
}

QPushButton#ScannerDetailFullButton {
  background: #D97706;
  border: 1px solid #D97706;
  color: #ffffff;
}

QPushButton#ScannerDetailFullButton:hover,
QPushButton#ScannerDetailFullButton:pressed {
  background: #F59E0B;
  border-color: #B45309;
  color: #ffffff;
}

QLabel#ScannerDetailHero {
  background: #1e293b;
  border: 1px solid #334155;
}

QLabel#ScannerDetailHero[candidateState="ready"] {
  background: #d1fae5;
  border: 1px solid #10b981;
  color: #047857;
}

QLabel#ScannerDetailHero[candidateState="wait"] {
  background: #fef3c7;
  border: 1px solid #f59e0b;
  color: #b45309;
}

QLabel#ScannerDetailHero[candidateState="watch"] {
  background: #fffbeb;
  border: 1px solid #f59e0b;
  color: #b45309;
}

QLabel#ScannerDetailHero[candidateState="blocked"] {
  background: #fef2f2;
  border: 1px solid #ef4444;
  color: #b91c1c;
}

QLabel#ScannerDetailHero[candidateState="neutral"] {
  background: #f1f5f9;
  border: 1px solid #94a3b8;
  color: #475569;
}

QLabel#ScannerDetailHero[candidateState="data"] {
  background: #f1f5f9;
  border: 1px solid #64748b;
  color: #475569;
}

QFrame#TradePanelCard,
QFrame#ScorePanelCard,
QFrame#ChecklistPanelCard {
  background: #ffffff;
  border: 1px solid #d1d5db;
}

QLabel#ScannerPanelTitle {
  color: #0f172a;
}

QLabel#ScannerPanelLabel {
  color: #475569;
}

QLabel#ScannerPanelValue[metricTone="buy"],
QLabel#ScannerPanelValue[metricTone="success"] {
  color: #10b981;
}

QLabel#ScannerPanelValue[metricTone="sell"],
QLabel#ScannerPanelValue[metricTone="danger"] {
  color: #e11d48;
}

QLabel#ScannerPanelValue[metricTone="warning"] {
  color: #f59e0b;
}

QLabel#ScannerPanelValue[metricTone="info"] {
  color: #38bdf8;
}

QLabel#ScannerPanelValue[metricTone="accent"] {
  color: #a78bfa;
}

QLabel#ScannerPanelValue[metricTone="text"] {
  color: #0f172a;
}

QLabel#ScannerPanelValue[metricTone="neutral"] {
  color: #94a3b8;
}

QLabel#ScannerPanelValue[metricTone="muted"] {
  color: #64748b;
}

QLabel#ScannerChecklistSummary[checkState="fail"],
QLabel#ScannerChecklistName[checkState="fail"] {
  color: #e11d48;
}

QLabel#ScannerChecklistName[checkState="pass"] {
  color: #10b981;
}

QLabel#ScannerChecklistSummary[checkState="unknown"],
QLabel#ScannerChecklistName[checkState="unknown"] {
  color: #94a3b8;
}

QLabel#ScannerAuditStatus {
  color: #94a3b8;
}

QLabel#ScannerSummaryRR,
QLabel#ScannerWarningText {
  color: #f59e0b;
}

QLabel#ScannerSummaryRollout {
  color: #38bdf8;
}

QLabel#ScannerSummaryText[metricTone="buy"],
QLabel#ScannerSummaryText[metricTone="success"],
QLabel#ScannerMacroScore[metricTone="success"] {
  color: #10b981;
}

QLabel#ScannerSummaryText[metricTone="sell"],
QLabel#ScannerSummaryText[metricTone="danger"] {
  color: #f43f5e;
}

QLabel#ScannerSummaryText[metricTone="warning"],
QLabel#ScannerMacroScore[metricTone="warning"] {
  color: #f59e0b;
}

QLabel#ScannerSummaryText[metricTone="neutral"],
QLabel#ScannerMacroScore[metricTone="neutral"] {
  color: #94a3b8;
}

QLabel#ScannerSummaryText[metricTone="muted"] {
  color: #64748b;
}

QLabel#ScannerSummaryText[metricTone="text"],
QLabel#ScannerDialogSectionTitle,
QLabel#ScannerTierLabel,
QLabel#ScannerTierScore {
  color: #0f172a;
}

QLabel#ScannerInfoLabel,
QLabel#ScannerMacroIndicators {
  color: #475569;
}

QLabel#ScannerInfoValue[metricTone="success"],
QLabel#ScannerHelpCell[metricTone="success"] {
  color: #059669;
}

QLabel#ScannerInfoValue[metricTone="warning"],
QLabel#ScannerHelpCell[metricTone="warning"] {
  color: #d97706;
}

QLabel#ScannerInfoValue[metricTone="danger"],
QLabel#ScannerHelpCell[metricTone="danger"] {
  color: #e11d48;
}

QLabel#ScannerInfoValue[metricTone="info"],
QLabel#ScannerHelpCell[metricTone="info"] {
  color: #0284c7;
}

QLabel#ScannerInfoValue[metricTone="accent"],
QLabel#ScannerHelpCell[metricTone="accent"] {
  color: #d94625;
}

QLabel#ScannerInfoValue[metricTone="neutral"],
QLabel#ScannerInfoValue[metricTone="muted"],
QLabel#ScannerHelpCell[metricTone="neutral"],
QLabel#ScannerHelpCell[metricTone="muted"] {
  color: #78716c;
}

QLabel#ScannerInfoValue[metricTone="text"],
QLabel#ScannerHelpCell[metricTone="text"] {
  color: #111827;
}

QProgressBar#ScannerTierProgress {
  background: #e2e8f0;
}

QProgressBar#ScannerTierProgress[metricTone="success"]::chunk {
  background: #059669;
}

QProgressBar#ScannerTierProgress[metricTone="warning"]::chunk {
  background: #d97706;
}

QProgressBar#ScannerTierProgress[metricTone="neutral"]::chunk {
  background: #78716c;
}

QLabel#ScannerMacroIndicators {
  border-top: 1px solid #e2e8f0;
}

QLabel#ScannerReasonText {
  color: #475569;
}

QFrame#ScannerWarningBanner {
  background: rgba(245, 158, 11, 0.05);
  border: 1px solid rgba(245, 158, 11, 0.2);
}

QLabel#ScannerChecklistText[checkState="pass"] {
  color: #10b981;
}

QLabel#ScannerChecklistText[checkState="fail"] {
  color: #f43f5e;
}

QLabel#ScannerChecklistText[checkState="unknown"] {
  color: #94a3b8;
}

QTextEdit#ScannerDetailText {
  color: #111827;
}

QFrame#HeroSummaryCard {
  background: #ffffff;
  border: 1px solid #d1d5db;
}

QLabel#JournalHeroText,
QLabel#JournalLifecycleStatusLabel {
  color: #0f172a;
}

QLabel#CardTitle[journalDetailTitle="true"] {
  color: #ea580c;
}

QTextEdit#JournalNoteInput {
  background: #f1f5f9;
  border: 1px solid #d1d5db;
  color: #0f172a;
}

QLabel#JournalLifecycleSectionTitle {
  border-bottom: 1px solid #d1d5db;
  color: #38bdf8;
}

QLabel#JournalLifecycleLabel {
  color: #475569;
}

QPushButton#TagChip {
  background: #f1f5f9;
  border: 1px solid #d1d5db;
  color: #475569;
}

QPushButton#TagChip:checked {
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid #ef4444;
  color: #ef4444;
}

QLabel#OrderDialogTitle {
  color: #111827;
}

QLabel#OrderDialogSubtitle {
  color: #4b5563;
}

QFrame#PanelCard[headerTone="success"] {
  background: #fbfbfb;
  border-left: 4px solid #10b981;
}

QFrame#PanelCard[headerTone="warning"] {
  background: #fbfbfb;
  border-left: 4px solid #fb923c;
}

QLabel#OrderDirectionPill[direction="buy"] {
  background: #d1fae5;
  color: #065f46;
}

QLabel#OrderDirectionPill[direction="sell"] {
  background: #ffe4e6;
  color: #9f1239;
}

QLabel#OrderDirectionPill[direction="neutral"] {
  background: #e5e7eb;
  color: #374151;
}

QPushButton#RestartButton {
  color: #D94625;
}

QPushButton#RestartButton:hover,
QPushButton#RestartButton:pressed {
  color: #E0533C;
}

QDialog#BacktestAnalysisDialog {
  background: #FAF9F5;
}

QDialog#BacktestAnalysisDialog QTextEdit#BacktestAnalysisText {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  color: #1e293b;
}

QDialog#BacktestConfigDialog {
  background: #faf8f5;
}

QLabel#BacktestConfigRowTitle {
  color: #1c1917;
}

QLabel#BacktestSummarySeparator {
  color: #64748b;
}

QPushButton {
  background: transparent;
  border: 1px solid #D94625;
  color: #D94625;
}

QPushButton:hover, QPushButton:pressed, QPushButton:checked {
  background: #D94625;
  border-color: #D94625;
  color: #ffffff;
}

QFrame#Sidebar {
  background: #EDEBE4;
  border-right: 1px solid #D6D2C8;
}

QLabel#SidebarTitle {
  color: #111827;
  @QSS_TITLE@
  font-weight: 700;
}

QLabel#SidebarSubtitle,
QLabel#SidebarFooter,
QLabel#PageSubtitle,
QLabel#CardDetail,
QLabel#ActionDetail,
QLabel#MiniStatTitle,
QLabel#WarningDetail,
QLabel#EmptyText,
QLabel#FormLabel,
QLabel#HelperText {
  color: #736B60;
}

QPushButton#NavButton {
  background: transparent;
  border: 1px solid transparent;
}

QPushButton#NavButton:hover, QPushButton#NavButton:pressed {
  background: #D94625;
  border-color: #D94625;
  color: #ffffff;
}

QPushButton#NavButton:checked {
  background: #D94625;
  border-color: #E0533C;
  color: #ffffff;
}

QPushButton#SidebarToggleButton,
QPushButton#FloatingSidebarToggle {
  background: #D94625;
  border: 1px solid #F5978A;
  color: #ffffff;
}

QPushButton#SidebarToggleButton:hover,
QPushButton#FloatingSidebarToggle:hover {
  background: #E0533C;
  border-color: #111827;
}


QLabel#PageTitle {
  color: #111827;
  @QSS_PAGE_TITLE@
  font-weight: 700;
}

QLabel#HeaderBadge {
  background: #FCE8E5;
  border: 1px solid #D94625;
  border-radius: 6px;
  color: #D94625;
  font-weight: 700;
  min-width: 72px;
  padding: 8px 12px;
}

QFrame#StatusCard,
QFrame#ActionCard,
QFrame#MiniStat,
QFrame#InlineStat,
QFrame#PanelCard,
QFrame#ChartPanel,
QFrame#AnalysisChartFrame,
QFrame#EntryConditionsCard,
QFrame#AnalysisRiskCard {
  background: #FAF9F5;
  border: 1px solid #D6D2C8;
}

QFrame#AnalysisStatusBadge {
  background: #FCE8E5;
  border: 1px solid #D94625;
  border-radius: 6px;
}

QLabel#StatusBadgeTitle {
  color: #111827;
  @QSS_SMALL@
  font-weight: 800;
}

QLabel#StatusBadgeValue {
  color: #231E19;
  @QSS_NUMBER@
  font-weight: 700;
}

QFrame#SupportCardCheck,
QFrame#SupportCardResult {
  background: #FAF9F5;
  border: 1px solid #D6D2C8;
}

QFrame#SupportCardCheck {
  border-left: 4px solid #E0533C;
}

QFrame#SupportCardResult {
  border-left: 4px solid #0284C7;
}

QLabel#SupportCardLine {
  color: #1E40AF;
  @QSS_BODY@
  font-weight: 600;
}

QFrame#ScannerDetailStat {
  background: #FAF9F5;
  border: 1px solid #D6D2C8;
}

QLabel#ScannerDetailStatTitle {
  color: #736B60;
  @QSS_SMALL@
  font-weight: 700;
}

QLabel#ScannerDetailStatValue {
  color: #231E19;
  @QSS_NUMBER@
  font-weight: 800;
}

QFrame#ScannerDecisionPanel {
  background: #FAF9F5;
  border: 1px solid #D6D2C8;
}

QFrame#ScannerDecisionHero {
  background: #EAE6DF;
  border: 1px solid #CCC7BD;
  border-radius: 8px;
}

QLabel#ScannerDecisionAction {
  background: #CCC7BD;
  border: 1px solid #A19B90;
  color: #231E19;
}

QLabel#ScannerDecisionAction[state="ready"] {
  background: #D1F0E3;
  border-color: #059669;
  color: #065F46;
}

QLabel#ScannerDecisionAction[state="wait"],
QLabel#ScannerDecisionAction[state="watch"] {
  background: #FEF3C7;
  border-color: #EAB308;
  color: #92400E;
}

QLabel#ScannerDecisionAction[state="skip"] {
  background: #FEE2E2;
  border-color: #fb7185;
  color: #9F1239;
}

QLabel#ScannerDecisionReason {
  color: #57534E;
  @QSS_BODY@
  font-weight: 700;
}

QFrame#ScannerDecisionMetric {
  background: #EDEBE4;
  border: 1px solid #D6D2C8;
  border-radius: 7px;
  min-height: 48px;
}

QLabel#ScannerDecisionMetricTitle {
  color: #8A8175;
  @QSS_SMALL@
  font-weight: 700;
}

QLabel#ScannerDecisionMetricValue {
  color: #231E19;
  @QSS_NUMBER@
  font-weight: 800;
}

QLabel#ScannerDecisionSectionTitle {
  color: #231E19;
  @QSS_SUBTITLE@
  font-weight: 900;
  padding-top: 4px;
}

QLabel#ScannerDecisionPill {
  background: #EAE6DF;
  border: 1px solid #D6D2C8;
  border-left: 4px solid #A19B90;
  border-radius: 6px;
  color: #1E293B;
  @QSS_BODY@
  font-weight: 650;
  padding: 7px 10px;
}

QLabel#ScannerDecisionPill[state="ok"] {
  border-left-color: #E0533C;
  color: #065F46;
}

QLabel#ScannerDecisionPill[state="wait"] {
  border-left-color: #EAB308;
  color: #92400E;
}

QLabel#ScannerDecisionPill[state="risk"] {
  border-left-color: #fb7185;
  color: #9F1239;
}

QScrollArea#ScannerDecisionScroll {
  background: transparent;
  border: 0;
}

QWidget#ScannerDecisionScrollContent {
  background: transparent;
}

QScrollArea#ScannerDecisionScroll QScrollBar:vertical {
  background: #EDEBE4;
  border-radius: 4px;
  width: 8px;
}

QScrollArea#ScannerDecisionScroll QScrollBar::handle:vertical {
  background: #CCC7BD;
  border-radius: 4px;
  min-height: 24px;
}

QScrollArea#ScannerDecisionScroll QScrollBar::handle:vertical:hover {
  background: #B5B0A6;
}

QScrollArea#ScannerDecisionScroll QScrollBar::add-line:vertical,
QScrollArea#ScannerDecisionScroll QScrollBar::sub-line:vertical {
  height: 0;
}

QFrame#AnalysisChartFrame {
  padding: 0;
}

QFrame#InlineStat QLabel#MiniStatTitle {
  color: #736B60;
