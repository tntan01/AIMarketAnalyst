QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WatchInput,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WaitInput,
QTableWidget#EconTable[tableRole="mt5Symbols"] QDoubleSpinBox#Mt5MinRrInput,
QTableWidget#EconTable[tableRole="mt5Symbols"] QComboBox {
  background: #EDEBE4;
  border: 1px solid #B5B0A6;
  color: #111827;
}

QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5MinScoreInput:hover,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5ReadyInput:hover,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WatchInput:hover,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WaitInput:hover,
QTableWidget#EconTable[tableRole="mt5Symbols"] QDoubleSpinBox#Mt5MinRrInput:hover,
QTableWidget#EconTable[tableRole="mt5Symbols"] QComboBox:hover {
  border: 1px solid #A19B90;
}

QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5MinScoreInput:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5ReadyInput:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WatchInput:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WaitInput:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QDoubleSpinBox#Mt5MinRrInput:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QComboBox:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QComboBox:on {
  border: 1px solid #0284C7;
}

QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5MinScoreInput:disabled,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5ReadyInput:disabled,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WatchInput:disabled,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WaitInput:disabled,
QTableWidget#EconTable[tableRole="mt5Symbols"] QDoubleSpinBox#Mt5MinRrInput:disabled,
QTableWidget#EconTable[tableRole="mt5Symbols"] QComboBox:disabled {
  background: #EAE6DF;
  border: 1px solid #CCC7BD;
  color: #8A8175;
}

QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5MinScoreInput[validationState="invalid"],
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5ReadyInput[validationState="invalid"],
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WatchInput[validationState="invalid"],
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WaitInput[validationState="invalid"],
QTableWidget#EconTable[tableRole="mt5Symbols"] QDoubleSpinBox#Mt5MinRrInput[validationState="invalid"],
QTableWidget#EconTable[tableRole="mt5Symbols"] QComboBox[validationState="invalid"] {
  border: 1px solid #DC2626;
}

QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5MinScoreInput[validationState="invalid"]:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5ReadyInput[validationState="invalid"]:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WatchInput[validationState="invalid"]:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WaitInput[validationState="invalid"]:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QDoubleSpinBox#Mt5MinRrInput[validationState="invalid"]:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QComboBox[validationState="invalid"]:focus,
QTableWidget#EconTable[tableRole="mt5Symbols"] QComboBox[validationState="invalid"]:on {
  border: 1px solid #EF4444;
}

QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5MinScoreInput[validationState="invalid"]:disabled,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5ReadyInput[validationState="invalid"]:disabled,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WatchInput[validationState="invalid"]:disabled,
QTableWidget#EconTable[tableRole="mt5Symbols"] QLineEdit#Mt5WaitInput[validationState="invalid"]:disabled,
QTableWidget#EconTable[tableRole="mt5Symbols"] QDoubleSpinBox#Mt5MinRrInput[validationState="invalid"]:disabled,
QTableWidget#EconTable[tableRole="mt5Symbols"] QComboBox[validationState="invalid"]:disabled {
  border: 1px solid #CCC7BD;
}

QScrollArea#SymbolScroll {
  background: #EDEBE4;
  border: 1px solid #D6D2C8;
  border-radius: 6px;
}

QScrollArea#SymbolScroll QWidget {
  background: #EDEBE4;
}

QHeaderView::section {
  background: #DEDAD0;
  border-right: 1px solid #CCC7BD;
  color: #453D35;
}

QTabWidget::pane {
  border: 1px solid #D6D2C8;
  background: #FAF9F5;
}

/* ── Default QTabBar::tab (applied globally to all QTabBars) ──────────── */
QTabBar::tab {
  background: #f1f5f9;
  border: 1px solid #d1d5db;
  color: #334155;
}

QTabBar::tab:selected {
  background: #ea580c;
  border: 1px solid #ea580c;
  color: #ffffff;
}

QTabBar::tab:hover {
  background: #f97316;
  border-color: #f97316;
  color: #ffffff;
}

/* ── QPushButton[tabStyle="PillTab"] — pill-shaped tab button (light) ──────── */
QPushButton[tabStyle="PillTab"] {
  border: 1px solid #d1d5db;
  background: #f1f5f9;
  color: #334155;
}

QPushButton[tabStyle="PillTab"]:hover {
  background: #e2e8f0;
  color: #1e293b;
  border-color: #94a3b8;
}

QPushButton[tabStyle="PillTab"][active="true"] {
  background: #ea580c;
  border: 1px solid #ea580c;
  color: #ffffff;
}

QPushButton[tabStyle="PillTab"][active="true"]:hover {
  background: #f97316;
  border-color: #ea580c;
}

QTabWidget#ContentTabs QTabBar::scroller {
  width: 76px;
}

QTabWidget#ContentTabs QTabBar QToolButton {
  background: #D94625;
  border: 1px solid #F5978A;
  color: #ffffff;
}

QTabWidget#ContentTabs QTabBar QToolButton:hover {
  background: #E0533C;
  border-color: #111827;
}

QTabWidget#ContentTabs QTabBar QToolButton:disabled {
  background: #DEDAD0;
  border-color: #CCC7BD;
  color: #A19B90;
}

QWidget#ResultTabStack {
  background: transparent;
}

QPushButton#ResultTabArrow {
  background: #D94625;
  border: 1px solid #F5978A;
  color: #ffffff;
}

QPushButton#ResultTabArrow:hover {
  background: #E0533C;
  border-color: #111827;
}

QPushButton#ResultTabArrow:pressed {
  background: #D94625;
}

QPushButton#ResultTabArrow:disabled {
  background: #DEDAD0;
  border-color: #CCC7BD;
  color: #A19B90;
}

QLabel#ResultTabPosition {
  background: #DBEAFE;
  border: 1px solid #F5978A;
  border-radius: 6px;
  color: #231E19;
  @QSS_SMALL@
  font-weight: 800;
  min-height: 24px;
  padding: 0 8px;
}

QFrame#ChartPanel {
  min-height: 260px;
}

QFrame#CompactFormPanel {
  background: transparent;
  border: 0;
}

QSplitter#SettingsAiSplitter::handle {
  background: #D6D2C8;
  border-left: 1px solid #D6D2C8;
  border-right: 1px solid #DEDAD0;
  margin: 4px 10px;
  width: 4px;
}

QSplitter#SettingsAiSplitter::handle:hover {
  background: #0284C7;
}

QLabel#HelperText {
  @QSS_SMALL@
}

QLabel#HelperText[state="ok"] {
  color: #34D399;
  font-weight: 700;
}

QLabel#HelperText[state="error"] {
  color: #FB7185;
  font-weight: 700;
}

QPushButton:disabled {
  background: #DEDAD0;
  border-color: #D6D2C8;
  color: #736B60;
}

QStatusBar {
  background: #EDEBE4;
  color: #736B60;
  border-top: 1px solid #D6D2C8;
}

QScrollArea#EconScroll QWidget {
  background: transparent;
}
QScrollArea#EconScroll QScrollBar:vertical {
  background: #EDEBE4;
  width: 8px;
  border-radius: 4px;
}
QScrollArea#EconScroll QScrollBar::handle:vertical {
  background: #CCC7BD;
  border-radius: 4px;
  min-height: 24px;
}
QScrollArea#EconScroll QScrollBar::handle:vertical:hover {
  background: #B5B0A6;
}
QScrollArea#EconScroll QScrollBar::add-line:vertical,
QScrollArea#EconScroll QScrollBar::sub-line:vertical {
  height: 0;
}

QPushButton#MarketHelpBtn {
  background: transparent;
  color: #F5978A;
  border: 1px solid #F5978A;
}
QPushButton#MarketHelpBtn:hover {
  background: #D94625;
  color: #fff;
  border-color: #F5978A;
}



QScrollArea#LifecycleScroll { background: transparent; border: none; }
QLabel#CardValue[impact="high"] { color: #E0533C; }
QLabel#CardValue[impact="medium"] { color: #D97706; }
QLabel#CardValue[impact="low"] { color: #736B60; }


QTableWidget#EconTable,
QTableView#EconTable {
  background: #FAF9F5;
  border: 1px solid #D6D2C8;
  border-radius: 8px;
  color: #111827;
  alternate-background-color: #F4F1EA;
  selection-background-color: #FCE8E5;
  selection-color: #111827;
}
QTableWidget#EconTable QHeaderView::section,
QTableView#EconTable QHeaderView::section {
  background: #EAE6DF;
  color: #736B60;
  @QSS_BODY@
  font-weight: 700;
  padding: 4px 8px;
  border: none;
  border-bottom: 2px solid #D94625;
  text-transform: uppercase;
}

/* Thanh cuộn dọc cho bảng Lịch kinh tế (EconTable) */
QTableWidget#EconTable QScrollBar:vertical,
QTableView#EconTable QScrollBar:vertical {
  background: #EAE6DF;
  width: 12px;
  border-radius: 4px;
  margin: 4px 2px 4px 2px;
}
QTableWidget#EconTable QScrollBar::handle:vertical,
QTableView#EconTable QScrollBar::handle:vertical {
  background: #CCC7BD;
  border-radius: 4px;
  min-height: 30px;
}
QTableWidget#EconTable QScrollBar::handle:vertical:hover,
QTableView#EconTable QScrollBar::handle:vertical:hover {
  background: #B5B0A6;
}
QTableWidget#EconTable QScrollBar::add-line:vertical,
QTableWidget#EconTable QScrollBar::sub-line:vertical,
QTableView#EconTable QScrollBar::add-line:vertical,
QTableView#EconTable QScrollBar::sub-line:vertical {
  height: 0px;
}
QTableWidget#EconTable QScrollBar::add-page:vertical,
QTableWidget#EconTable QScrollBar::sub-page:vertical,
QTableView#EconTable QScrollBar::add-page:vertical,
QTableView#EconTable QScrollBar::sub-page:vertical {
  background: transparent;
}

/* ==========================================================================
   ScanAnalysisDetailDialog Custom Styles (Light Theme)
   ========================================================================== */
QDialog#ScanAnalysisDetailDialog {
  background: #f8fafc;
}

QDialog#ScanAnalysisDetailDialog QLabel {
  @QSS_BODY@
  color: #0f172a;
}

QDialog#ScanAnalysisDetailDialog QLabel#ScannerSummaryRR,
QDialog#ScanAnalysisDetailDialog QLabel#ScannerWarningText {
  color: #f59e0b;
}

QDialog#ScanAnalysisDetailDialog QLabel#ScannerSummaryRollout {
  color: #38bdf8;
}

QFrame#PriceCard, QFrame#ScannerGroupCard, QFrame#M15Card, QFrame#JournalSampleCard, QFrame#JournalExpectancyCard {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
}

QFrame#MacroContextCard, QFrame#ChecklistCard {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
}

QFrame#SummaryPillBuy, QFrame#SummaryPillSell, QFrame#SummaryPillNeutral, QFrame#SummaryPillStatus, QFrame#SummaryPillScore, QFrame#SummaryPillRR, QFrame#SummaryPillPerm, QFrame#SummaryPillRollout {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  padding: 4px 10px;
}

QFrame#SummaryPillBuy {
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.25);
}

QFrame#SummaryPillSell {
  background: rgba(244, 63, 94, 0.1);
  border: 1px solid rgba(244, 63, 94, 0.25);
}

QFrame#SummaryPillNeutral {
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.25);
}

QFrame#ChecklistRowCardPass {
  background: rgba(16, 185, 129, 0.05);
  border: 1px solid rgba(16, 185, 129, 0.12);
  border-radius: 6px;
}

QFrame#ChecklistRowCardFail {
  background: rgba(244, 63, 94, 0.05);
  border: 1px solid rgba(244, 63, 94, 0.12);
  border-radius: 6px;
}

QFrame#ChecklistRowCardUnknown {
  background: rgba(100, 116, 139, 0.05);
  border: 1px solid rgba(100, 116, 139, 0.12);
  border-radius: 6px;
}

QFrame#MacroProgressBarBg {
  background: #e2e8f0;
  border-radius: 3px;
}

QFrame#MacroProgressBarFill {
  border-radius: 3px;
}

QLabel#MacroReasonLabel {
  @QSS_SMALL@
  color: #64748b;
}

/* ── NotePopup (Journal note popover) ─────────────────────────── */
QFrame#NotePopup {
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
}

QLabel#NotePopupText {
  color: #1e293b;
  @QSS_BODY@
  padding: 2px 0;
}


