}

QLabel#ScannerMacroIndicators {
  border-top: 1px solid #242b3d;
}

QLabel#ScannerReasonText {
  color: #cbd5e1;
}

QFrame#ScannerWarningBanner {
  background: rgba(245, 158, 11, 0.08);
