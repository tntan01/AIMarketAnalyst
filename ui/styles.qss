}

QDialog#BacktestAnalysisDialog {
  background: #1a1f2e;
}

QDialog#BacktestAnalysisDialog QTextEdit#BacktestAnalysisText {
  background: #0f172a;
  border: 1px solid #1e293b;
  color: #e2e8f0;
}

QDialog#BacktestConfigDialog {
  background: #17120f;
}

QTableWidget#LuuTrungHoaTable {
  border: 1px solid #3f2c25;
}

QTableWidget#LuuTrungHoaTable::item {
  border-bottom: 1px solid #3f2c25;
}

QLabel#BacktestConfigRowTitle {
  color: #ebdcd0;
}

QLabel#BacktestSummarySeparator {
  color: #64748b;
}

QPushButton {
  background: #1b2028;
  border: 1px solid #334155;
  color: #e5e7eb;
}

QPushButton:hover,
QPushButton:pressed,
QPushButton:checked {
  background: #263142;
  border-color: #38bdf8;
}

QFrame#Sidebar {
  background: #111827;
  border-right: 1px solid #273244;
}

QLabel#SidebarTitle {
  color: #f9fafb;
  font-size: 18px;
  font-weight: 700;
}

QLabel#SidebarSubtitle,
QLabel#SidebarFooter,
QLabel#PageSubtitle,
QLabel#CardDetail,
QLabel#ActionDetail,
QLabel#MiniStatTitle,
QLabel#WarningDetail,
QLabel#EmptyText,
QLabel#FormLabel,
QLabel#HelperText {
  color: #9ca3af;
}

QPushButton#NavButton {
  background: transparent;
  border: 1px solid transparent;
}

QPushButton#NavButton:hover,
QPushButton#NavButton:pressed {
  background: #1f2937;
  border-color: #334155;
}

QPushButton#NavButton:checked {
  background: #0f766e;
  border-color: #14b8a6;
  color: #ffffff;
}

QPushButton#SidebarToggleButton,
QPushButton#FloatingSidebarToggle {
  background: #0f766e;
  border: 1px solid #5eead4;
  color: #ffffff;
}

QPushButton#SidebarToggleButton:hover,
QPushButton#FloatingSidebarToggle:hover {
  background: #14b8a6;
  border-color: #99f6e4;
}

QPushButton#FloatingSidebarToggle {
  background: #12352f;
}

QLabel#PageTitle {
  color: #f9fafb;
  font-size: 28px;
  font-weight: 700;
}

QLabel#HeaderBadge {
  background: #12352f;
  border: 1px solid #10b981;
  border-radius: 6px;
  color: #6ee7b7;
  font-weight: 700;
  min-width: 72px;
  padding: 8px 12px;
}

QFrame#StatusCard,
QFrame#ActionCard,
QFrame#MiniStat,
QFrame#InlineStat,
QFrame#PanelCard,
QFrame#ChartPanel,
QFrame#AnalysisChartFrame,
QFrame#EntryConditionsCard,
QFrame#AnalysisRiskCard {
  background: #171c24;
  border: 1px solid #2b3545;
}

QFrame#AnalysisStatusBadge {
  background: #12352f;
  border: 1px solid #0d9488;
  border-radius: 6px;
}

QLabel#StatusBadgeTitle {
  color: #99f6e4;
  font-size: 11px;
  font-weight: 800;
}

QLabel#StatusBadgeValue {
  color: #f8fafc;
  font-size: 11px;
  font-weight: 700;
}

QFrame#SupportCardCheck,
QFrame#SupportCardResult {
  background: #171c24;
  border: 1px solid #2b3545;
}

QFrame#SupportCardCheck {
  border-left: 4px solid #14b8a6;
}

QFrame#SupportCardResult {
  border-left: 4px solid #38bdf8;
}

QLabel#SupportCardLine {
  color: #dbeafe;
  font-size: 13px;
  font-weight: 600;
}

QFrame#ScannerDetailStat {
  background: #171c24;
  border: 1px solid #2b3545;
}

QLabel#ScannerDetailStatTitle {
  color: #9ca3af;
  font-size: 12px;
  font-weight: 700;
}

QLabel#ScannerDetailStatValue {
  color: #f8fafc;
  font-size: 14px;
  font-weight: 800;
}

QFrame#ScannerDecisionPanel {
  background: #171c24;
  border: 1px solid #2b3545;
}

QFrame#ScannerDecisionHero {
  background: #0f172a;
  border: 1px solid #334155;
  border-radius: 8px;
}

QLabel#ScannerDecisionAction {
  background: #334155;
  border: 1px solid #64748b;
  color: #f8fafc;
}

QLabel#ScannerDecisionAction[state="ready"] {
  background: #064e3b;
  border-color: #10b981;
  color: #ccfbf1;
}

QLabel#ScannerDecisionAction[state="wait"],
QLabel#ScannerDecisionAction[state="watch"] {
  background: #3f3107;
  border-color: #facc15;
  color: #fef3c7;
}

QLabel#ScannerDecisionAction[state="skip"] {
  background: #3f1d24;
  border-color: #fb7185;
  color: #ffe4e6;
}

QLabel#ScannerDecisionReason {
  color: #cbd5e1;
  font-size: 12px;
  font-weight: 700;
}

QFrame#ScannerDecisionMetric {
  background: #111827;
  border: 1px solid #273244;
  border-radius: 7px;
  min-height: 48px;
}

QLabel#ScannerDecisionMetricTitle {
  color: #94a3b8;
  font-size: 10px;
  font-weight: 700;
}

QLabel#ScannerDecisionMetricValue {
  color: #f8fafc;
  font-size: 12px;
  font-weight: 800;
}

QLabel#ScannerDecisionSectionTitle {
  color: #f8fafc;
  font-size: 13px;
  font-weight: 900;
  padding-top: 4px;
}

QLabel#ScannerDecisionPill {
  background: #101826;
  border: 1px solid #2b3545;
  border-left: 4px solid #64748b;
  border-radius: 6px;
  color: #dbeafe;
  font-size: 11px;
  font-weight: 650;
  padding: 7px 10px;
}

QLabel#ScannerDecisionPill[state="ok"] {
  border-left-color: #14b8a6;
  color: #ccfbf1;
}

QLabel#ScannerDecisionPill[state="wait"] {
  border-left-color: #facc15;
  color: #fef3c7;
}

QLabel#ScannerDecisionPill[state="risk"] {
  border-left-color: #fb7185;
  color: #ffe4e6;
}

QScrollArea#ScannerDecisionScroll {
  background: transparent;
  border: 0;
}

QWidget#ScannerDecisionScrollContent {
  background: transparent;
}

QScrollArea#ScannerDecisionScroll QScrollBar:vertical {
  background: #111827;
  border-radius: 4px;
  width: 8px;
}

QScrollArea#ScannerDecisionScroll QScrollBar::handle:vertical {
  background: #334155;
  border-radius: 4px;
  min-height: 24px;
}

QScrollArea#ScannerDecisionScroll QScrollBar::handle:vertical:hover {
  background: #475569;
}

QScrollArea#ScannerDecisionScroll QScrollBar::add-line:vertical,
