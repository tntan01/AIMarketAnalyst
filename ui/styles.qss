}

QLabel#ScannerChecklistText[checkState="pass"] {
  color: #10b981;
}

QLabel#ScannerChecklistText[checkState="fail"] {
  color: #f43f5e;
}

QLabel#ScannerChecklistText[checkState="unknown"] {
  color: #94a3b8;
}

QTextEdit#ScannerDetailText {
  color: #e5e7eb;
}

QFrame#HeroSummaryCard {
