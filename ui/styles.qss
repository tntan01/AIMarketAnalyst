QMainWindow {
  background: #0f1216;
}

QWidget#AppShell,
QWidget#DashboardScreen,
QWidget#FormScreen,
QStackedWidget#ContentStack {
  background: #0f1216;
}

QDialog,
QMenu,
QCalendarWidget,
QAbstractScrollArea,
QWidget#qt_scrollarea_viewport {
  background: #0f1216;
  color: #e5e7eb;
}

QAbstractItemView {
  alternate-background-color: #171c24;
  background: #0f172a;
  border: 1px solid #334155;
  color: #e5e7eb;
  selection-background-color: #0f766e;
  selection-color: #ffffff;
}

QAbstractItemView::item:hover {
  background: #1f2937;
}

QAbstractItemView::item:selected {
  background: #143735;
  color: #e5e7eb;
}

QScrollBar:horizontal,
QScrollBar:vertical {
  background: #0b1220;
  border: 1px solid #263244;
}

QScrollBar::handle:horizontal,
QScrollBar::handle:vertical {
  background: #0f766e;
  border: 1px solid #5eead4;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:hover {
  background: #14b8a6;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  background: #0b1220;
  border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: #0f172a;
}

QSplitter::handle {
  background: #334155;
  border-color: #475569;
}

QMenu::item:selected {
  background: #0f766e;
  color: #ffffff;
}

QMenu::item:disabled {
  color: #64748b;
}

QLabel {
  color: #e5e7eb;
}

QFrame#InfoCard {
  background: #1e293b;
  border: 1px solid #334155;
}

QFrame#InfoCard:hover {
  border-color: #475569;
}

QLabel#InfoCardLabel {
  color: #94a3b8;
}

QLabel#InfoCardValue {
  color: #38bdf8;
}

QLabel#InfoCardValue[accentRole="accent"] {
  color: #0f766e;
}

QLabel#InfoCardValue[accentRole="success"] {
  color: #10b981;
}

QLabel#InfoCardValue[accentRole="warning"] {
  color: #f59e0b;
}

QLabel#InfoCardValue[accentRole="danger"] {
  color: #ef4444;
}

QLabel#InfoCardValue[accentRole="info"] {
  color: #38bdf8;
}

QLabel#InfoCardDetail {
  color: #64748b;
}

QTextEdit#BacktestResultText {
  background: #0f172a;
  color: #e2e8f0;
}

QLabel#BacktestVerdict[verdictState="empty"] {
  background: #0f172a;
  border: 1px solid #1e293b;
}

QLabel#BacktestVerdict[verdictState="success"] {
  background: #064e3b;
  border: 1px solid #065f46;
}

QLabel#BacktestVerdict[verdictState="warning"] {
  background: #451a03;
  border: 1px solid #78350f;
}

QLabel#BacktestVerdict[verdictState="unclear"] {
  background: #431407;
  border: 1px solid #7c2d12;
}

QLabel#BacktestVerdict[verdictState="danger"] {
  background: #4c0519;
  border: 1px solid #881337;
}

QLabel#MiniStatValueCompact[metricTone="info"] {
  color: #38bdf8;
}

QLabel#MiniStatValueCompact[metricTone="success"] {
  color: #10b981;
}

QLabel#MiniStatValueCompact[metricTone="warning"] {
  color: #f59e0b;
}

QLabel#MiniStatValueCompact[metricTone="danger"] {
  color: #ef4444;
}

QLabel#MiniStatValueCompact[metricTone="accent"] {
  color: #a855f7;
}

QLabel#MarketBadge {
  color: #e5e7eb;
}

QLabel#MarketBadge[metricTone="positive"] {
  color: #10b981;
}

QLabel#MarketBadge[metricTone="danger"] {
  color: #e11d48;
}

QLabel#MarketBadge[metricTone="warning"] {
  color: #f59e0b;
}

QLabel#MarketBadge[metricTone="neutral"] {
  color: #e5e7eb;
}

QPushButton#NewsLinkButton[linkTone="past"],
QPushButton#NewsIconButton[linkTone="past"] {
  color: #64748b;
}

QPushButton#NewsLinkButton[linkTone="past"]:hover,
QPushButton#NewsIconButton[linkTone="past"]:hover {
  color: #94a3b8;
}

QPushButton#NewsLinkButton[linkTone="nearest"],
QPushButton#NewsIconButton[linkTone="nearest"] {
  color: #10b981;
}

QPushButton#NewsLinkButton[linkTone="nearest"]:hover,
QPushButton#NewsIconButton[linkTone="nearest"]:hover {
  color: #34d399;
}

QPushButton#NewsLinkButton[linkTone="future"],
QPushButton#NewsIconButton[linkTone="future"] {
  color: #ea580c;
}

QPushButton#NewsLinkButton[linkTone="future"]:hover,
QPushButton#NewsIconButton[linkTone="future"]:hover {
  color: #fb923c;
}

QPushButton#NewsLinkButton[linkTone="danger"] {
  color: #f87171;
}

QPushButton#NewsLinkButton[linkTone="danger"]:hover {
  color: #fca5a5;
}

QPushButton#NewsLinkButton[linkTone="warning"] {
  color: #fbbf24;
}

QPushButton#NewsLinkButton[linkTone="warning"]:hover {
  color: #fcd34d;
}

QPushButton#DialogAiButton {
  background: #ea580c;
  color: #ffffff;
}

QPushButton#DialogAiButton:hover {
  background: #f97316;
}

QPushButton#DialogAiButton:disabled {
  background: #1f2937;
  border: 1px solid #273244;
  color: #6b7280;
}

QLabel#CardDetailLabel {
  color: #888888;
}

QDialog#MarketHelpDialog {
  background: #1a1f2e;
}

QDialog#MarketBriefDialog {
  background: #1a1f2e;
}

QLabel#MarketBriefTitle,
QLabel#MarketBriefSectionTitle {
  color: #ea580c;
}

QLabel#MarketBriefTimestamp {
  color: #64748b;
}

QFrame#MarketBriefContainer {
  background: #171c24;
  border: 1px solid #2b3545;
}

QFrame#MarketBriefSectionCard {
  background: #1e2533;
  border: 1px solid #2b3545;
}

QLabel#MarketBriefSectionContent {
  color: #cbd5e1;
}

QLabel#KPICardTitle {
  color: #94a3b8;
}

QLabel#KPICardValue {
  color: #f8fafc;
}

QLabel#KPICardSub {
  color: #64748b;
}

QFrame#PerformanceKPICard {
  background: #1e293b;
  border: 1px solid #334155;
}

QFrame#PerformanceKPICard[kpiState="positive"] {
  border-left: 4px solid #10b981;
}

QFrame#PerformanceKPICard[kpiState="negative"] {
  border-left: 4px solid #ef4444;
}

QFrame#PerformanceKPICard[kpiState="warning"] {
  border-left: 4px solid #f59e0b;
}

QFrame#PerformanceKPICard[kpiState="neutral"] {
  border-left: 4px solid #3b82f6;
}

QFrame#PerformanceKPICard[kpiState="muted"] {
  border-left: 4px solid #475569;
}

QLabel#KPICardValue[kpiState="positive"] {
  color: #34d399;
}

QLabel#KPICardValue[kpiState="negative"] {
  color: #f87171;
}

QLabel#KPICardValue[kpiState="warning"] {
  color: #fbbf24;
}

QLabel#KPICardValue[kpiState="neutral"] {
  color: #38bdf8;
}

QLabel#KPICardValue[kpiState="muted"] {
  color: #64748b;
}

QLabel#KPICardSub[kpiState="positive"] {
  color: #10b981;
}

QLabel#KPICardSub[kpiState="negative"] {
  color: #ef4444;
}

QLabel#KPICardSub[kpiState="warning"] {
  color: #f59e0b;
}

QLabel#KPICardSub[kpiState="neutral"],
QLabel#KPICardSub[kpiState="muted"] {
  color: #64748b;
}

QLabel#MissingRText {
  color: #fbbf24;
}

QFrame#MissingRBanner[state="warning"] {
  background: rgba(245, 158, 11, 0.15);
  border: 1px solid #f59e0b;
}

QLabel#MissingRText[state="warning"] {
  color: #fef08a;
}

QLabel#JournalSectionLabel {
  color: #38bdf8;
}

QPushButton#ScannerDetailFullButton {
  background: #D97706;
  border: 1px solid #D97706;
  color: #ffffff;
}

QPushButton#ScannerDetailFullButton:hover,
QPushButton#ScannerDetailFullButton:pressed {
  background: #F59E0B;
  border-color: #B45309;
  color: #ffffff;
}

QLabel#ScannerDetailHero {
  background: #1e293b;
  border: 1px solid #334155;
}

QLabel#ScannerDetailHero[candidateState="ready"] {
  background: #064e3b;
  border: 1px solid #10b981;
  color: #34d399;
}

QLabel#ScannerDetailHero[candidateState="wait"] {
  background: #451a03;
  border: 1px solid #f59e0b;
  color: #fbbf24;
}

QLabel#ScannerDetailHero[candidateState="watch"] {
  background: #291700;
  border: 1px solid #f59e0b;
  color: #fbbf24;
}

QLabel#ScannerDetailHero[candidateState="blocked"] {
  background: #3f1017;
  border: 1px solid #ef4444;
  color: #f87171;
}

QLabel#ScannerDetailHero[candidateState="neutral"] {
  background: #1e293b;
  border: 1px solid #94a3b8;
  color: #cbd5e1;
}

QLabel#ScannerDetailHero[candidateState="data"] {
  background: #111827;
  border: 1px solid #64748b;
  color: #94a3b8;
}

QFrame#TradePanelCard,
QFrame#ScorePanelCard,
QFrame#ChecklistPanelCard {
  background: #1a1f2e;
  border: 1px solid #2b3545;
}

QLabel#ScannerPanelTitle {
  color: #f1f5f9;
}

QLabel#ScannerPanelLabel {
  color: #94a3b8;
}

QLabel#ScannerPanelValue[metricTone="buy"],
QLabel#ScannerPanelValue[metricTone="success"] {
  color: #10b981;
}

QLabel#ScannerPanelValue[metricTone="sell"],
QLabel#ScannerPanelValue[metricTone="danger"] {
  color: #e11d48;
}

QLabel#ScannerPanelValue[metricTone="warning"] {
  color: #f59e0b;
}

QLabel#ScannerPanelValue[metricTone="info"] {
  color: #38bdf8;
}

QLabel#ScannerPanelValue[metricTone="accent"] {
  color: #a78bfa;
}

QLabel#ScannerPanelValue[metricTone="text"] {
  color: #f1f5f9;
}

QLabel#ScannerPanelValue[metricTone="neutral"] {
  color: #94a3b8;
}

QLabel#ScannerPanelValue[metricTone="muted"] {
  color: #64748b;
}

QLabel#ScannerChecklistSummary[checkState="fail"],
QLabel#ScannerChecklistName[checkState="fail"] {
  color: #e11d48;
}

QLabel#ScannerChecklistName[checkState="pass"] {
  color: #10b981;
}

QLabel#ScannerChecklistSummary[checkState="unknown"],
QLabel#ScannerChecklistName[checkState="unknown"] {
  color: #94a3b8;
}

QLabel#ScannerAuditStatus {
  color: #94a3b8;
}

QLabel#ScannerSummaryRR,
QLabel#ScannerWarningText {
  color: #f59e0b;
}

QLabel#ScannerSummaryRollout {
  color: #38bdf8;
}

QLabel#ScannerSummaryText[metricTone="buy"],
QLabel#ScannerSummaryText[metricTone="success"],
QLabel#ScannerMacroScore[metricTone="success"] {
  color: #10b981;
}

QLabel#ScannerSummaryText[metricTone="sell"],
QLabel#ScannerSummaryText[metricTone="danger"] {
  color: #f43f5e;
}

QLabel#ScannerSummaryText[metricTone="warning"],
QLabel#ScannerMacroScore[metricTone="warning"] {
  color: #f59e0b;
}

QLabel#ScannerSummaryText[metricTone="neutral"],
QLabel#ScannerMacroScore[metricTone="neutral"] {
  color: #94a3b8;
}

QLabel#ScannerSummaryText[metricTone="muted"] {
  color: #64748b;
}

QLabel#ScannerSummaryText[metricTone="text"],
QLabel#ScannerDialogSectionTitle,
QLabel#ScannerTierLabel,
QLabel#ScannerTierScore {
  color: #f1f5f9;
}

QLabel#ScannerInfoLabel,
QLabel#ScannerMacroIndicators {
  color: #94a3b8;
}

QLabel#ScannerInfoValue[metricTone="success"],
QLabel#ScannerHelpCell[metricTone="success"] {
  color: #10b981;
}

QLabel#ScannerInfoValue[metricTone="warning"],
QLabel#ScannerHelpCell[metricTone="warning"] {
  color: #f59e0b;
}

QLabel#ScannerInfoValue[metricTone="danger"],
QLabel#ScannerHelpCell[metricTone="danger"] {
  color: #ef4444;
}

QLabel#ScannerInfoValue[metricTone="info"],
QLabel#ScannerHelpCell[metricTone="info"] {
  color: #38bdf8;
}

QLabel#ScannerInfoValue[metricTone="accent"],
QLabel#ScannerHelpCell[metricTone="accent"] {
  color: #14b8a6;
}

QLabel#ScannerInfoValue[metricTone="neutral"],
QLabel#ScannerInfoValue[metricTone="muted"],
QLabel#ScannerHelpCell[metricTone="neutral"],
QLabel#ScannerHelpCell[metricTone="muted"] {
  color: #94a3b8;
}

QLabel#ScannerInfoValue[metricTone="text"],
QLabel#ScannerHelpCell[metricTone="text"] {
  color: #e5e7eb;
}

QProgressBar#ScannerTierProgress {
  background: #1e293b;
}

QProgressBar#ScannerTierProgress[metricTone="success"]::chunk {
  background: #10b981;
}

QProgressBar#ScannerTierProgress[metricTone="warning"]::chunk {
  background: #f59e0b;
}

QProgressBar#ScannerTierProgress[metricTone="neutral"]::chunk {
