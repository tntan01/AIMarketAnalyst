  border: 1px solid #2b3545;
}

QLabel#JournalHeroText,
QLabel#JournalLifecycleStatusLabel {
  color: #f1f5f9;
}

QLabel#CardTitle[journalDetailTitle="true"] {
  color: #f97316;
}

QTextEdit#JournalNoteInput {
  background: #1e293b;
  border: 1px solid #2b3545;
  color: #f1f5f9;
}

QLabel#JournalLifecycleSectionTitle {
  border-bottom: 1px solid #2b3545;
  color: #38bdf8;
}

QLabel#JournalLifecycleLabel {
  color: #94a3b8;
}

QPushButton#TagChip {
  background: #1e293b;
  border: 1px solid #2b3545;
  color: #94a3b8;
}

QPushButton#TagChip:checked {
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid #ef4444;
  color: #ef4444;
}

QLabel#OrderDialogTitle {
  color: #f8fafc;
}

QLabel#OrderDialogSubtitle {
  color: #9ca3af;
}

QFrame#PanelCard[headerTone="success"] {
  background: #171c24;
  border-left: 4px solid #10b981;
}

QFrame#PanelCard[headerTone="warning"] {
  background: #171c24;
  border-left: 4px solid #fb923c;
}

QLabel#OrderDirectionPill[direction="buy"] {
  background: #064e3b;
  color: #34d399;
}

QLabel#OrderDirectionPill[direction="sell"] {
  background: #4c0519;
  color: #f87171;
}

QLabel#OrderDirectionPill[direction="neutral"] {
