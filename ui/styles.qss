}

/* ====================================================================
   TAB STYLES — Reusable tab appearance classes
   ====================================================================

   Usage (Python):
     # PillTab — QPushButton-based tab bar (e.g. order screen):
     btn.setProperty("tabStyle", "PillTab")
     btn.setProperty("active", True)   # for the active/selected tab
     btn.style().unpolish(btn)
     btn.style().polish(btn)
   ==================================================================== */

/* ── Default QTabBar::tab (applied globally to all QTabBars) ──────────── */
QTabBar::tab {
  background: #1f2937;
  border: 1px solid #475569;
  color: #e5e7eb;
}

QTabBar::tab:selected {
  background: #0f766e;
  border: 1px solid #5eead4;
  color: #ffffff;
}

QTabBar::tab:hover {
  background: #334155;
  border-color: #94a3b8;
  color: #ffffff;
}

/* ── QPushButton[tabStyle="PillTab"] — pill-shaped tab button ──────────── */
QPushButton[tabStyle="PillTab"] {
  border: 1px solid #475569;
  background: #1f2937;
  color: #94a3b8;
}

QPushButton[tabStyle="PillTab"]:hover {
  background: #334155;
  color: #e5e7eb;
  border-color: #94a3b8;
}

QPushButton[tabStyle="PillTab"][active="true"] {
  background: #0f766e;
  border: 1px solid #5eead4;
  color: #ffffff;
}

QPushButton[tabStyle="PillTab"][active="true"]:hover {
  background: #14b8a6;
  border-color: #99f6e4;
}

QTabWidget#ContentTabs QTabBar::scroller {
  width: 76px;
}

QTabWidget#ContentTabs QTabBar QToolButton {
  background: #0f766e;
  border: 1px solid #5eead4;
  color: #ffffff;
}

QTabWidget#ContentTabs QTabBar QToolButton:hover {
  background: #14b8a6;
  border-color: #99f6e4;
}

QTabWidget#ContentTabs QTabBar QToolButton:disabled {
  background: #1f2937;
  border-color: #334155;
  color: #64748b;
}

QWidget#ResultTabStack {
