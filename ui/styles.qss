/* ==========================================================================
   ScanAnalysisDetailDialog Custom Styles
   ========================================================================== */
QDialog#ScanAnalysisDetailDialog {
  background: #0b0f19;
}

QDialog#ScanAnalysisDetailDialog QLabel {
  font-family: "Segoe UI", "Arial", sans-serif;
  color: #f8fafc;
}

QDialog#ScanAnalysisDetailDialog QLabel#ScannerSummaryRR,
QDialog#ScanAnalysisDetailDialog QLabel#ScannerWarningText {
  color: #f59e0b;
}

QDialog#ScanAnalysisDetailDialog QLabel#ScannerSummaryRollout {
  color: #38bdf8;
}

QFrame#PriceCard, QFrame#ScannerGroupCard, QFrame#M15Card, QFrame#JournalSampleCard, QFrame#JournalExpectancyCard {
  background: #161b26;
  border: 1px solid #242b3d;
  border-radius: 8px;
}

QFrame#MacroContextCard, QFrame#ChecklistCard {
  background: #161b26;
  border: 1px solid #242b3d;
  border-radius: 8px;
}

QFrame#SummaryPillBuy, QFrame#SummaryPillSell, QFrame#SummaryPillNeutral, QFrame#SummaryPillStatus, QFrame#SummaryPillScore, QFrame#SummaryPillRR, QFrame#SummaryPillPerm, QFrame#SummaryPillRollout {
  background: #161b26;
  border: 1px solid #242b3d;
  border-radius: 6px;
  padding: 4px 10px;
}

QFrame#SummaryPillBuy {
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.3);
}

QFrame#SummaryPillSell {
  background: rgba(244, 63, 94, 0.1);
  border: 1px solid rgba(244, 63, 94, 0.3);
}

QFrame#SummaryPillNeutral {
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.3);
}

QFrame#ChecklistRowCardPass {
  background: rgba(16, 185, 129, 0.06);
  border: 1px solid rgba(16, 185, 129, 0.15);
  border-radius: 6px;
}

QFrame#ChecklistRowCardFail {
  background: rgba(244, 63, 94, 0.06);
  border: 1px solid rgba(244, 63, 94, 0.15);
  border-radius: 6px;
}

QFrame#ChecklistRowCardUnknown {
  background: rgba(148, 163, 184, 0.06);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 6px;
}

QFrame#MacroProgressBarBg {
  background: #1e293b;
  border-radius: 3px;
}

QFrame#MacroProgressBarFill {
  border-radius: 3px;
}

QLabel#MacroReasonLabel {
  font-size: 11px;
  color: #64748b;
}

